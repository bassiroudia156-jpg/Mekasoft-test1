generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  // Nullable: OAuth-only users (e.g. signed up with Google) never set a
  // password. Email/password signup still requires it; the auth route
  // enforces presence at runtime.
  passwordHash      String?
  emailVerifiedAt   DateTime?
  tokenVersion      Int       @default(0)
  withdrawalPinHash String? // bcrypt hash of withdrawal PIN; null = no PIN set
  // Optional display name — populated from OAuth profile on first sign-in.
  // Email/password users can fill it later via /api/auth/me PATCH (Phase 8).
  name              String?
  // Optional avatar URL — populated from OAuth profile on first sign-in, or
  // set by the user via /api/upload + /api/auth/me PATCH (Phase 8).
  avatarUrl         String?
  // E.164, editable via /api/auth/me PATCH (Phase 8's EditProfileModal).
  // 2026-08-24 — unique (nullable-unique: Postgres allows any number of
  // NULLs under a unique index, only non-null duplicates are rejected) so
  // /api/auth/login can look a user up by phone as an alternate to email
  // (dual login — PRD "téléphone comme identifiant", scoped to login only;
  // signup still requires email, see login/route.ts's header comment).
  // /api/auth/me PATCH enforces the same uniqueness at the app layer with a
  // friendly PHONE_ALREADY_IN_USE error before this constraint would 500.
  phone             String?   @unique
  // App-wide role. USER is the default; ADMIN unlocks /admin back-office;
  // SUPERADMIN can promote/demote other admins. Bootstrap an initial
  // SUPERADMIN via `pnpm db:make-superadmin <email>` (see scripts).
  role              String    @default("USER") // USER | ADMIN | SUPERADMIN
  // Account status. ACTIVE = login + refresh allowed; SUSPENDED = both
  // refused with 403 ACCOUNT_SUSPENDED. Mutated via /api/admin/users/[id]/status
  // (ADMIN can suspend; only SUPERADMIN can restore).
  status            String    @default("ACTIVE") // ACTIVE | SUSPENDED
  // Set on every successful /api/auth/login (2026-08-20, admin dashboard
  // "Utilisateurs actifs" KPI — needs a real signal, not a placeholder).
  // NOT stamped by the OAuth callback (frontend/src/app/api/auth/oauth/
  // google/callback — PROTECTED file, out of scope to touch) — an
  // OAuth-only user's lastLoginAt stays null until this is revisited.
  // Deliberately NOT bumped by token refresh either — that would make
  // "active" mean "has an open tab", which overcounts.
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  verificationCodes VerificationCode[]
  uploads           FileUpload[]
  notifications     Notification[]
  notifPrefs        NotificationPreferences?
  orders            Order[]
  withdrawals       Withdrawal[]
  oauthAccounts     OAuthAccount[]
  adminActions      AdminAction[]

  // Multi-tenancy is opt-in per project: by default no resource is org-scoped.
  // Apps that need it (marketplace, B2B SaaS, classifieds) wire owner relations
  // on their domain models.
  ownedOrganizations Organization[]       @relation("OrgOwner")
  memberships        OrganizationMember[] @relation("OrgMembership")
  invitesSent        OrganizationInvite[] @relation("InviteSender")

  @@index([email])
  @@index([role])
  @@index([status])
}

// ───────────────────────────────────────────────────────────────────────
// Admin audit log — every back-office mutation is recorded here so we can
// answer "who did what when" during incidents / compliance reviews.
//
// `action` is a free-form dotted string the UI groups by (e.g.
// "withdrawal.cancel", "user.role_change", "order.refund").
// `targetType` + `targetId` reference the affected row when applicable.
// `metadata` carries the diff or extra context as JSON.
//
// Retention: not pruned automatically (compliance). If your jurisdiction
// requires deletion after N years, add a cron in backend/src/index.ts
// modeled on the WebhookLog purge.
// ───────────────────────────────────────────────────────────────────────
model AdminAction {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

// ───────────────────────────────────────────────────────────────────────
// Multi-tenancy primitives — opt-in.
//
// Default project surface stays user-owned (`Order.userId`, `Withdrawal.userId`).
// Apps that need orgs add `organizationId String?` to their domain models
// case by case and use `requireOrgRole()` middleware to gate access.
//
// Slug must be unique app-wide (not just within an owner) so it can be
// used as a stable URL segment.
// ───────────────────────────────────────────────────────────────────────
model Organization {
  id                   String                @id @default(cuid())
  slug                 String                @unique
  name                 String
  ownerId              String
  owner                User                  @relation("OrgOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members              OrganizationMember[]
  invites              OrganizationInvite[]
  clients              Client[]
  vehicles             Vehicle[]
  interventions        Intervention[]
  invoices             Invoice[]
  payments             Payment[]
  quotes               Quote[]
  subscription         Subscription?
  subscriptionPayments SubscriptionPayment[]

  // MekaSoft onboarding fields (Banani OnboardingStep2/Step3) — captured
  // once at org-creation time, editable later from Settings (Phase 8).
  phone        String? // E.164, e.g. +221771234567
  city         String?
  teamSizeHint String? // SOLO | SMALL | MEDIUM | LARGE — analytics signal from onboarding step 3, not a hard limit

  // Freemium plan (2026-08-18) — FREE | PRO | BUSINESS, see
  // lib/server/plans/limits.ts for the actual limits/features per plan.
  // Plain String (no DB-level enum), so a stray/legacy value can still show
  // up — every consumer must fall back safely rather than assume it's
  // valid (see getPlanLimits()/isPlan()/isPayablePlan()).
  plan          String    @default("FREE")
  planUpdatedAt DateTime?
  // Garage logo shown on invoice PDFs — Pro+ only (gated in the PDF
  // renderer regardless of whether a FREE-plan org somehow has one set).
  logoUrl       String?

  // Shop-identity fields (Banani EditShopSettingsPage, Phase 8) — editable
  // via PATCH /api/organizations, requireCallerOrg('ADMIN').
  street        String? // matches Client.street naming
  postalCode    String?
  country       String? @default("Sénégal") // matches Client.country default
  taxId         String? // "Numéro SIRET" — matches Client's Company taxId naming
  siren         String? // "Numéro SIREN"
  contactEmail  String? // shop's own contact email, distinct from the owner's login email
  hoursWeekday  String? @default("07h00 - 18h00")
  hoursSaturday String? @default("08h00 - 14h00")
  hoursSunday   String? @default("Fermé")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

// Role precedence: OWNER > ADMIN > MEMBER. The owner is also a member row
// (created in the same tx as the org) so list-my-orgs queries can join
// uniformly via memberships.
model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("OrgMembership", fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("MEMBER") // OWNER | ADMIN | MEMBER — permission level, gates requireOrgRole()
  // Cosmetic job-title label from Banani's TeamManagementModal (Gérant /
  // Administrateur / Mécanicien / Comptable / …) — display only, never
  // read by the access-control layer. Kept separate from `role` because
  // require-org-role.ts's ORG_ROLE_RANK only knows OWNER/ADMIN/MEMBER.
  jobTitle       String?
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
}

// ───────────────────────────────────────────────────────────────────────
// Team invitations (Banani AddTeamMemberModal → TeamMemberInvitationSent).
// The invitee usually has no User row yet — accepting an invite creates
// one (email pre-verified: the invite link itself proves ownership, same
// trust model as the email-verification code). V1 assumes single-org-per-
// user, so an invite to an email that already owns a User account is
// rejected at send time rather than handled at accept time.
// ───────────────────────────────────────────────────────────────────────
model OrganizationInvite {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  name           String
  role           String // OWNER | ADMIN | MEMBER — granted to the OrganizationMember row on accept
  jobTitle       String // Administrateur | Mécanicien | Comptable | … — see OrganizationMember.jobTitle
  token          String       @unique
  status         String       @default("PENDING") // PENDING | ACCEPTED | CANCELLED | EXPIRED
  invitedById    String
  invitedBy      User         @relation("InviteSender", fields: [invitedById], references: [id], onDelete: Restrict)
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId, status])
  @@index([email])
}

// ───────────────────────────────────────────────────────────────────────
// OAuth identities — one User can have N linked providers (Google, GitHub, …).
// (provider, providerAccountId) is unique so the same Google account can't
// link twice. Email matching at sign-in is intentional: if a user signed up
// with email/password and later "Sign in with Google" using the same email,
// we link the Google account to the existing user instead of creating a
// duplicate (see backend/src/routes/oauth.ts).
// ───────────────────────────────────────────────────────────────────────
model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String // "google" | "github" | …
  providerAccountId String // sub from the OIDC ID token
  // Optional refresh token (encrypted at rest if you store one) — Google
  // only returns it on first consent with `access_type=offline`. Most
  // boilerplate flows don't need it; we keep the column for future use.
  refreshToken      String?
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model VerificationCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  type      String // EMAIL_VERIFY | PASSWORD_RESET
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([userId, type])
  @@index([code, type])
}

// ───────────────────────────────────────────────────────────────────────
// File uploads — Cloudinary (column names kept from the R2 era; no migration needed)
// ───────────────────────────────────────────────────────────────────────
model FileUpload {
  id        String   @id @default(cuid())
  userId    String? // nullable — uploads can be anonymous if route allows
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  key       String   @unique // Cloudinary public_id (column name historical — was R2 object key)
  filename  String
  mimeType  String
  sizeBytes Int
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — durable email queue rows
// ───────────────────────────────────────────────────────────────────────
model EmailJob {
  id          String    @id @default(cuid())
  to          String
  subject     String
  html        String
  text        String?
  status      String    @default("PENDING") // PENDING | SENT | FAILED | DEAD
  attempts    Int       @default(0)
  lastError   String?
  scheduledAt DateTime  @default(now())
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  // Single-attachment support (Phase 6 — invoice PDFs). Base64 content,
  // nullable — every prior email sender (verification/reset/invite) never
  // sets these, so existing rows/behavior are unaffected.
  attachmentFilename    String?
  attachmentContent     String? @db.Text
  attachmentContentType String?

  @@index([status, scheduledAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — notifications (at-most-once via dedupeKey)
// ───────────────────────────────────────────────────────────────────────
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  data      Json?
  dedupeKey String    @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model NotificationPreferences {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // JSON map of { eventType: { email: bool, inApp: bool } } — flexible without migrations.
  prefs     Json     @default("{}")
  updatedAt DateTime @updatedAt
}

// ───────────────────────────────────────────────────────────────────────
// Outbox — durable side-effects (notifications, emails) emitted from
// inside transactions (e.g. webhook handlers, withdrawal flow). Side-effect
// rows are inserted in the same tx as the state change, then a worker
// drains them. Survives crashes the previous postCommit-callback pattern
// silently dropped.
//
// `kind` is a free-form string the dispatcher routes on
// (e.g. "notification.payment_received", "email.payment_confirmation").
// ───────────────────────────────────────────────────────────────────────
model OutboxEvent {
  id          String    @id @default(cuid())
  kind        String
  payload     Json
  status      String    @default("PENDING") // PENDING | SENT | FAILED | DEAD
  attempts    Int       @default(0)
  lastError   String?
  scheduledAt DateTime  @default(now())
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, scheduledAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — webhook idempotency log
// ───────────────────────────────────────────────────────────────────────
model WebhookLog {
  id          String    @id @default(cuid())
  provider    String
  externalId  String
  eventType   String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([externalId, eventType])
  @@index([provider, createdAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 3 — payments (Order + Withdrawal)
//
// `amount` is stored in the smallest unit of `currency` (no decimals).
// For XOF (FCFA, Senegal) that's 1 = 1 FCFA. For USD adapt to cents
// at the call site — the schema is currency-agnostic.
// ───────────────────────────────────────────────────────────────────────
model Order {
  id            String  @id @default(cuid())
  userId        String? // nullable — guest checkout supported
  user          User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  amount        Int // gross amount, smallest unit
  currency      String  @default("XOF") // ISO 4217
  status        String  @default("PENDING") // PENDING | PAID | EXPIRED | FAILED | REFUNDED
  customerEmail String?
  customerPhone String?
  customerName  String?
  metadata      Json? // app-specific fields

  // Stripe-grade idempotency. Required header on POST /api/orders; replay
  // with same value returns the original Order row instead of double-charging.
  // Nullable so existing rows pre-migration don't break the @unique constraint.
  idempotencyKey String? @unique

  // Provider reference
  provider         String // e.g. "bictorys"
  providerChargeId String? @unique
  paymentUrl       String? // checkout/redirect URL returned by provider
  paymentMethod    String? // WAVE | ORANGE_MONEY | FREE_MONEY (set on PAID by webhook)

  // Optional commission (for marketplace-style apps)
  commissionAmount Int?
  netAmount        Int?

  // Lifecycle
  expiresAt DateTime // PENDING expiry; not cleared on PAID (history)
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@index([provider, providerChargeId])
}

model Withdrawal {
  id          String @id @default(cuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  amount      Int // requested amount, smallest unit
  currency    String @default("XOF")
  status      String @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED | CANCELLED
  destination Json // { method: "WAVE" | "ORANGE_MONEY" | ..., phone: "+221...", accountName?: "..." }

  // Provider reference
  provider         String // e.g. "bictorys"
  providerPayoutId String? @unique
  failureReason    String?

  requestedAt DateTime  @default(now())
  processedAt DateTime?
  completedAt DateTime?

  @@index([userId, requestedAt])
  @@index([status, requestedAt])
  @@index([provider, providerPayoutId])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 4 — Clients & Vehicles (Banani ClientsList / AddNewClient /
// ClientProfile / VehiclesList / AddVehicle / DeleteVehicleConfirmation).
//
// A Client is either an INDIVIDUAL or a COMPANY (Banani's "Particulier" /
// "Entreprise" toggle on AddNewClient) — one model, type-discriminated
// fields, not two separate models. Display name is computed at the API
// layer (firstName+lastName for individuals, companyName for companies),
// not denormalized, so there is one source of truth.
// ───────────────────────────────────────────────────────────────────────
model Client {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           String // INDIVIDUAL | COMPANY
  status         String       @default("actif") // actif | inactif — matches ClientRow's lowercase status literal

  // Individual-only fields (Banani AddNewIndividualClient)
  firstName   String?
  lastName    String?
  profession  String?
  dateOfBirth DateTime?
  gender      String?
  idNumber    String?

  // Company-only fields (Banani AddNewClient_next1 "Add New Company")
  companyName  String?
  taxId        String? // SIRET / N° fiscal
  sector       String?
  contactName  String?
  contactRole  String?
  contactPhone String?
  contactEmail String?

  // Shared contact + address
  phone      String
  email      String?
  street     String? // "Quartier/Rue"
  city       String?
  postalCode String?
  country    String? @default("Sénégal")
  notes      String?

  vehicles      Vehicle[]
  interventions Intervention[]
  invoices      Invoice[]
  payments      Payment[]
  quotes        Quote[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
}

model Vehicle {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // Banani "Propriétaire du véhicule: Client lui-même / Entreprise cliente"
  // — whether the vehicle is personal or company property. Independent of
  // Client.type (a COMPANY client's contact can still register a personal
  // vehicle, and vice versa).
  ownerType      String       @default("INDIVIDUAL") // INDIVIDUAL | COMPANY

  brand         String
  model         String
  year          Int?
  registration  String
  mileage       Int? // km
  fuelType      String?
  vin           String? // N° de série
  engineNumber  String?
  color         String?
  status        String    @default("Actif") // Actif | Inactif — matches VehicleRow's capitalized status literal
  lastServiceAt DateTime? // set once Interventions ship (Phase 5); null renders "—"
  notes         String?

  interventions Intervention[]
  quotes        Quote[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([organizationId, registration])
  @@index([organizationId, status])
  @@index([clientId])
}

// ───────────────────────────────────────────────────────────────────────
// Interventions & Parts (Banani NewIntervention / InterventionsList /
// InterventionDetailsView / AddParts). An Intervention is a repair job
// (dossier de réparation) tied to one client + one vehicle. `status` is a
// single 4-value field matching InterventionRow's own prop shape exactly
// (En cours/Terminé/En attente/Non payé) — committed in
// IMPLEMENTATION-PLAN.md's domain model before Phase 0 started, not a
// Phase 5 fork. Client/Vehicle FKs are Restrict (not Cascade) — deleting a
// client/vehicle with intervention history must fail loudly, not silently
// orphan billing data (the DELETE /api/vehicles/[id] comment from Phase 4
// already flagged this as a "revisit once Intervention exists").
// ───────────────────────────────────────────────────────────────────────
model Intervention {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reference      String // INT-### sequential per organization

  clientId  String
  client    Client  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  work     String // description of work to perform
  category String?
  priority String  @default("Normal") // Normal | Urgente
  notes    String?

  // Money — integer FCFA, no decimals (CLAUDE.md invariant). `amount` is
  // the denormalized TTC total (labor + parts + tax), recomputed by
  // lib/server/interventions/totals.ts on every create/parts mutation so
  // InterventionRow's list display never needs to recompute tax logic.
  laborAmount Int @default(0)
  partsAmount Int @default(0)
  taxRatePct  Int @default(18)
  amount      Int @default(0)

  status String @default("En cours") // En cours | Terminé | En attente | Non payé

  parts     Part[]
  invoice   Invoice? // one invoice per intervention (see Invoice.interventionId unique)
  // Set on either side of the Quote↔Intervention link (2026-08-25): an
  // intervention created FROM an accepted quote (see Quote.interventionId),
  // OR an intervention that later had a quote generated from it via the
  // existing devis-preview flow. Nullable — most interventions have none.
  quote     Quote?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, reference])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([clientId])
  @@index([vehicleId])
}

model Part {
  id             String       @id @default(cuid())
  interventionId String
  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)

  reference String?
  name      String
  supplier  String?
  quantity  Int     @default(1)
  unit      String  @default("pcs")
  unitPrice Int // FCFA
  total     Int // FCFA, quantity * unitPrice, denormalized
  inStock   Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([interventionId])
}

// ───────────────────────────────────────────────────────────────────────
// Quotes (devis) — 2026-08-25, Phase C decision #8: upgraded from the
// PDF-preview-only devis (still available, unchanged, off Intervention
// directly) to a real object with a lifecycle. Two creation paths:
//   1. From an existing Intervention (mirrors the old devis-preview flow —
//      interventionId set at creation, work/parts/amounts snapshotted from
//      it so the quote doesn't silently drift if the intervention is
//      edited afterward).
//   2. From scratch (client + vehicle picked directly, no Intervention yet
//      — "chiffrer avant d'accepter le travail") — interventionId null
//      until/unless the quote is later converted.
// `status` DRAFT → SENT → ACCEPTED | REJECTED | EXPIRED. ACCEPTED +
// interventionId set = "converted" (no separate CONVERTED status — one
// less transition to get wrong). `token` powers the public, no-auth
// accept/reject link (same shape as OrganizationInvite.token — a
// crypto-random base64url string, not guessable); staff can ALSO record
// accept/reject manually from the back-office for a client who responded
// by phone instead of clicking the link — both paths write the same
// status/respondedAt/respondedByName fields, `respondedByName` just says
// "Client (lien)" vs the staff member's name so the audit trail shows how.
// ───────────────────────────────────────────────────────────────────────
model Quote {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reference      String // DEV-YYYY-### sequential per organization per calendar year

  clientId  String
  client    Client  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  // Nullable: null until either created from an intervention, or converted
  // to one after acceptance. onDelete SetNull rather than Restrict — no
  // route deletes an Intervention today, but a quote's own history
  // shouldn't become undeletable-by-proxy if that ever changes.
  interventionId String?       @unique
  intervention   Intervention? @relation(fields: [interventionId], references: [id], onDelete: SetNull)

  work        String // description of work — snapshot, independent of the source intervention's own `work` after creation
  laborAmount Int    @default(0)
  partsAmount Int    @default(0)
  taxRatePct  Int    @default(18)
  taxAmount   Int    @default(0)
  subtotal    Int    @default(0) // laborAmount + partsAmount
  amount      Int    @default(0) // subtotal + taxAmount (TTC)

  status     String    @default("DRAFT") // DRAFT | SENT | ACCEPTED | REJECTED | EXPIRED
  token      String    @unique // public accept/reject link — POST /api/quotes/respond/[token]
  validUntil DateTime // defaults to +30 days at creation, editable while DRAFT

  sentAt          DateTime?
  respondedAt     DateTime?
  respondedByName String? // "Client (lien)" for the public-token path, or the staff member's name for a manual entry

  notes String?

  parts     QuotePart[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([organizationId, reference])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([clientId])
  @@index([vehicleId])
}

model QuotePart {
  id      String @id @default(cuid())
  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  name      String
  supplier  String?
  quantity  Int     @default(1)
  unit      String  @default("pcs")
  unitPrice Int // FCFA
  total     Int // FCFA, quantity * unitPrice, denormalized

  createdAt DateTime @default(now())

  @@index([quoteId])
}

// ───────────────────────────────────────────────────────────────────────
// Invoices (Banani NewInvoice / InvoicesList / InvoiceDetailsFromEmail).
// Generated FROM an intervention — one invoice per intervention
// (`interventionId` unique). `description`/`subtotal`/`taxAmount`/`amount`
// are a snapshot taken at issue time, not a live join: an invoice must not
// silently change if the underlying intervention is edited afterward.
// `status` is manually set (same "Marquer comme payé" convenience-action
// pattern as Intervention) — no automatic overdue detection.
// ───────────────────────────────────────────────────────────────────────
model Invoice {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reference      String // FAC-YYYY-### sequential per organization per calendar year

  interventionId String       @unique
  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Restrict)
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)

  description String // snapshot of intervention.work
  subtotal    Int // FCFA HT
  taxRatePct  Int    @default(18)
  taxAmount   Int
  amount      Int // FCFA TTC

  paymentTerms String   @default("Net 30 jours")
  issueDate    DateTime @default(now())
  dueDate      DateTime
  status       String   @default("Émise") // Émise | Payée | En attente
  notes        String?

  // Set by the outbox dispatcher once the email is actually enqueued to the
  // mailer (not at emit time) — drives the "Historique" timeline.
  emailSentAt DateTime?
  emailSentTo String?

  payments  Payment[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([organizationId, reference])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([clientId])
}

// ───────────────────────────────────────────────────────────────────────
// Payments (Banani PaymentsManagement / RegisterPayment / PaymentRegistered
// Confirmation) — a manual back-office ledger entry a garage staffer
// records after receiving money for an Invoice. NOT the same concept as
// `lib/server/payments/`'s `PaymentProvider` (the Bictorys online-charge
// gateway, protected file) — this model has no gateway, no webhook, no
// circuit breaker; helpers live in `lib/server/payment-ledger/` to keep
// the two concerns from blurring together. One form, `method`
// discriminated union (Espèces/Virement bancaire/Mobile Money/Chèque);
// `amount` always mirrors `invoice.amount` — no partial payments were
// designed anywhere in the 109 screens. Registering a payment marks the
// invoice `Payée` regardless of the payment's own `status` (see
// phase-7-payments.md decision #2 for the documented tension this
// creates with a pending bank transfer/uncashed cheque).
// ───────────────────────────────────────────────────────────────────────
model Payment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reference      String // PAY-YYYY-### sequential per organization per calendar year

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  clientId  String
  client    Client  @relation(fields: [clientId], references: [id], onDelete: Restrict)

  amount      Int // FCFA — snapshot of invoice.amount at registration time
  method      String // Espèces | Virement bancaire | Mobile Money | Chèque
  status      String   @default("Payé") // Payé | En attente — derived at creation, immutable after
  paymentDate DateTime @default(now())
  notes       String?

  generateReceipt  Boolean @default(true)
  receiptReference String? // REC-{invoice year}-{invoice seq}-PAY-{payment seq}

  // Virement bancaire
  bankName          String?
  bankAccountLast4  String?
  transferReference String?
  payerName         String?

  // Mobile Money
  mobileProvider  String? // Orange Money | Wave | Free Money
  mobilePhone     String?
  mobileReference String?

  // Chèque
  chequeNumber  String?
  chequeBank    String?
  chequeHolder  String?
  chequeDueDate DateTime?

  createdAt DateTime @default(now())

  @@unique([organizationId, reference])
  @@index([organizationId, status])
  @@index([organizationId, paymentDate])
  @@index([invoiceId])
  @@index([clientId])
}

// ───────────────────────────────────────────────────────────────────────
// SaaS subscription billing (2026-08-18) — a garage (Organization) paying
// MekaSoft for its own PRO/BUSINESS plan. Deliberately NOT the same domain
// as `Payment` above (a garage's CLIENT paying the garage for a repair) —
// different actor, different money flow, different provider set. Kept in
// its own model pair rather than reusing the generic `Order` scaffold
// (frontend/src/app/api/orders/route.ts) because Order is user-scoped and
// hardwired to a single Bictorys provider-singleton; a subscription is
// org-scoped and needs 3 concurrent providers (Stripe/Moneroo/Chariow).
// See lib/server/subscriptions/.
//
// One Subscription row per Organization (upserted in place — no history of
// past plans here; SubscriptionPayment is the append-only ledger for that).
// `provider = STRIPE` renews automatically (card, Stripe-hosted recurring
// billing) so `graceEndsAt` stays null. `provider = MONEROO | CHARIOW` is a
// one-shot mobile-money checkout with no push-renewal capability — the
// relance cron (lib/server/subscriptions/reminders.ts) emails/WhatsApps the
// org before `currentPeriodEnd`, and a `graceEndsAt` (currentPeriodEnd +
// SUBSCRIPTION_GRACE_DAYS) gives a few extra days before the downgrade cron
// (lib/server/subscriptions/downgrade.ts) reverts Organization.plan to FREE.
// ───────────────────────────────────────────────────────────────────────
model Subscription {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  plan     String // PRO or BUSINESS — the plan this subscription pays for (never FREE, see Organization.plan's comment)
  provider String // STRIPE | MONEROO | CHARIOW
  status   String @default("ACTIVE") // ACTIVE | GRACE | EXPIRED | CANCELED

  // Paid-through date. For STRIPE this tracks the current Stripe billing
  // period end (advanced by invoice.paid); for MONEROO/CHARIOW it's simply
  // "checkout date + 1 month", advanced only by a fresh manual checkout.
  currentPeriodEnd  DateTime
  // Set only for MONEROO/CHARIOW rows (currentPeriodEnd + grace days). Null
  // for STRIPE — a card subscription either renews or Stripe itself marks
  // it past_due/canceled, no separate app-level grace needed.
  graceEndsAt       DateTime?
  // STRIPE only — true once the user cancels from the Customer Portal;
  // the subscription still runs until currentPeriodEnd, then downgrade.ts
  // reverts to FREE instead of expecting a renewal invoice.
  cancelAtPeriodEnd Boolean   @default(false)

  // Stripe-specific refs (null for MONEROO/CHARIOW rows).
  stripeCustomerId     String?
  stripeSubscriptionId String? @unique

  // Relance bookkeeping — prevents double-sending the same reminder tier
  // (see SUBSCRIPTION_REMINDER_DAYS_BEFORE) across overlapping cron ticks.
  remindersSent      Int       @default(0)
  lastReminderSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, currentPeriodEnd])
  @@index([provider])
}

// Append-only ledger — one row per checkout attempt/renewal, regardless of
// provider. Powers idempotent webhook fulfilment (`@@unique([provider,
// providerRef])`, same pattern as WebhookLog's dedup key) and a future
// "billing history" UI.
model SubscriptionPayment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  plan        String // PRO or BUSINESS, see Organization.plan's comment
  provider    String // STRIPE | MONEROO | CHARIOW
  // Stripe: checkout.session.id (then invoice.id for renewals). Moneroo:
  // payment id. Chariow: purchase.id (sale id, per Chariow.md §3.1).
  providerRef String

  amount   Int // FCFA, integer smallest unit — matches Payment.amount convention
  currency String @default("XOF")
  status   String @default("PENDING") // PENDING | SUCCEEDED | FAILED

  checkoutUrl String? // hosted checkout page handed back to the client

  createdAt   DateTime  @default(now())
  succeededAt DateTime?

  @@unique([provider, providerRef])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
}

// ───────────────────────────────────────────────────────────────────────
// Anonymous SaaS-subscription checkout (2026-08-19) — the landing page's
// "S'abonner" buttons for logged-out visitors. Deliberately a SEPARATE model
// from SubscriptionPayment rather than making SubscriptionPayment.organizationId
// nullable: that field is relied on non-optionally everywhere (fulfillment.ts,
// admin routes, the receipt PDF route, …), and loosening it would ripple
// through code that's already live against real Stripe charges. Instead, a
// standalone row holds just enough (email/atelierName/phone) to create the
// Organization + User AFTER payment succeeds, inside the webhook — see
// lib/server/subscriptions/anonymous.ts. `organizationId` here is set only
// once fulfillment has run (idempotency marker + audit trail of which org
// resulted); it is NOT a foreign key, since it may be an existing org (email
// already had an account) rather than a newly created one.
model AnonymousSubscriptionIntent {
  id          String @id @default(cuid())
  email       String
  atelierName String
  phone       String

  plan        String // PRO or BUSINESS, see Organization.plan's comment
  provider    String // STRIPE | MONEROO | CHARIOW
  providerRef String // provider's checkout/session reference

  amount   Int
  currency String @default("XOF")
  status   String @default("PENDING") // PENDING | SUCCEEDED | FAILED

  checkoutUrl    String?
  organizationId String? // set once fulfillment resolves/creates the org
  // existing_org | new_org_existing_user | new_org_new_user — which branch
  // resolveOrganizationForAnonymousIntent() took, so the confirmation page
  // knows whether to say "check your email to set a password" (new_org_new_user)
  // or "log in now" (the other two, which already have a usable password).
  resultKind     String?

  createdAt   DateTime  @default(now())
  succeededAt DateTime?

  @@unique([provider, providerRef])
  @@index([email])
  @@index([status])
}

// ============================================================================
// Admin back-office additions (2026-08-20) — Banani flow "Tableau Atelier",
// screen "Admin Dashboard — Vue d'ensemble" + hand-designed sibling pages
// (Utilisateurs/Garages/Tarification/Promotions/Analytics/Intégrations/
// Support/Feedback/Journal d'activité). See .planning/banani/admin-dashboard.md.
// ============================================================================

// Admin-editable subscription pricing. Single source of truth for price
// stays `lib/server/plans/limits.ts`'s PLAN_PRICING constant — this table
// is an optional override read by `lib/server/plans/pricing.ts`'s
// `getPlanPricing()`. Empty table (or a plan with no row) falls back to the
// static constant, so the app never breaks if this table hasn't been
// seeded yet. Only 'PRO'/'BUSINESS' are ever expected to have a row in
// practice (FREE is definitionally 0 and the admin UI doesn't offer to
// edit it), but the model itself doesn't hardcode that assumption.
model PlanPricing {
  id                String   @id @default(cuid())
  plan              String   @unique // 'PRO' | 'BUSINESS' today; schema doesn't special-case it
  priceFcfa         Int
  originalPriceFcfa Int?
  updatedAt         DateTime @updatedAt
  updatedByAdminId  String?

  @@index([plan])
}

// Admin-editable payment-provider credentials (2026-08-22 — "je veux que tu
// me crée la section où on peut renseigner toutes les infos nécessaires
// pour connecter chariow"). Same override-with-env-fallback shape as
// PlanPricing above: a row here wins over the matching env var when
// present, so an admin can rotate a key from the dashboard without a
// redeploy. `provider` is unique so this doubles as a one-row-per-provider
// table; only 'CHARIOW' is wired today (Chariow uniquely needs this: its
// webhook auth is a shared secret placed directly in the callback URL, no
// HMAC, so a wrong value pasted into that URL — which is exactly what
// caused the 2026-08-22 incident, see lib/server/subscriptions/chariow.ts —
// silently breaks payments until someone notices; Stripe/Moneroo verify
// webhooks via header HMAC instead and don't have this failure mode).
// Secret fields are ciphertext ONLY (lib/server/crypto.ts AES-256-GCM,
// ENCRYPTION_KEY env var) — the plaintext value is never persisted and
// never returned to the client, only a masked last-4 hint.
model PaymentProviderCredential {
  id                     String   @id @default(cuid())
  provider               String   @unique // 'CHARIOW' today; extensible to STRIPE/MONEROO
  encryptedApiKey        String?
  encryptedWebhookSecret String?
  productIdPro           String?
  productIdBusiness      String?
  updatedAt              DateTime @updatedAt
  updatedByAdminId       String?

  @@index([provider])
}

// Promo codes. Redemption is atomic (guard + increment in one tx, mirroring
// the withdrawals/lock.ts pattern) to prevent a maxRedemptions coupon from
// being oversold under concurrent checkouts — see
// lib/server/coupons/redeem.ts.
model Coupon {
  id               String    @id @default(cuid())
  code             String    @unique // stored uppercase, validated case-insensitively at lookup
  discountType     String // PERCENT | FIXED
  discountValue    Int // 1-100 for PERCENT; FCFA amount for FIXED
  // null = applies to any paid plan. Only 'PRO' is meaningful today (the
  // only paid plan), kept as a string (not a bool) so a future second paid
  // tier doesn't need a schema change.
  appliesToPlan    String?
  // null = unlimited redemptions.
  maxRedemptions   Int?
  redeemedCount    Int       @default(0)
  active           Boolean   @default(true)
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  createdByAdminId String?

  redemptions CouponRedemption[]

  @@index([code])
  @@index([active])
}

// One row per successful redemption — lets the admin Promotions page show
// "who used this code" and lets checkout routes tie a discounted amount
// back to its coupon without parsing free-text. Exactly one of
// subscriptionPaymentId / anonymousIntentId is set, matching the existing
// two-parallel-flows split (SubscriptionPayment = authenticated upgrade,
// AnonymousSubscriptionIntent = landing-page checkout) — no FK to either
// (both models are fair-game/high-churn; a soft reference avoids coupling
// this table's migrations to theirs).
model CouponRedemption {
  id                    String   @id @default(cuid())
  couponId              String
  coupon                Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  subscriptionPaymentId String?
  anonymousIntentId     String?
  amountBeforeFcfa      Int
  amountAfterFcfa       Int
  redeemedAt            DateTime @default(now())

  @@index([couponId])
  @@index([subscriptionPaymentId])
  @@index([anonymousIntentId])
}

// Support tickets — submitted from /profile (logged-in) via POST /api/support
// (rate-limited, optionalAuth: userId set when logged in, still accepts
// anonymous name+email). Admin inbox at /admin/support; reply sends a real
// email via EmailQueue (see lib/server/support/email-templates.ts) and
// moves status to RESOLVED.
model SupportTicket {
  id         String    @id @default(cuid())
  userId     String?
  name       String
  email      String
  subject    String
  message    String
  status     String    @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([status, createdAt])
  @@index([email])
}

// Free-text product feedback + optional star rating — submitted from
// /profile via POST /api/feedback (rate-limited, optionalAuth). Admin list
// at /admin/feedback with a "traité" (reviewed) toggle; no reply mechanism
// (unlike SupportTicket) — this is one-way signal, not a conversation.
model Feedback {
  id        String   @id @default(cuid())
  userId    String?
  message   String
  rating    Int? // 1-5, optional
  reviewed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([reviewed, createdAt])
}
